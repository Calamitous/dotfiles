#!/bin/sh
# scriptorium -- one entry point for the writing tools.
#
#   scriptorium init [path]     set a vault up (rules, dictionary, .gitignore),
#                               creating it first if there's no vault there yet
#   scriptorium draft <Title> [folder]
#                               start a new draft (an Index.md Longform and
#                               compile.rb both read); folder defaults to Title
#   scriptorium compile         build the manuscript
#   scriptorium check           build without writing; diff against the current
#   scriptorium steps           show the pipeline, and where the build will land
#   scriptorium drafts          list the drafts in this vault
#   scriptorium select <Index>  remember which draft to build
#   scriptorium docx            build, and render a .docx via pandoc
#
# The individual scripts (vault-init, draft-init, compile.rb) still work
# directly; this is just a front door so there's one name to remember. `init` is
# the one place they differ: it passes --create, so
# `scriptorium init ~/Writing/new-book` makes the vault, while bare `vault-init`
# still expects one to exist.
#
# A new book is the two in order: `init` for the vault, `draft` for the first
# draft inside it.

set -e

# Resolve through the symlink in ~/.local/bin to find the sibling scripts.
# Written the long way because macOS `readlink` has no -f.
src=$0
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case $src in
    /*) ;;
    *) src=$dir/$src ;;
  esac
done
BIN=$(cd -P "$(dirname "$src")" && pwd)

usage() {
  # The header comment IS the help text: everything from the title line down to
  # the first line of code. Printed by shape rather than by line number, so
  # adding a command above can't silently truncate it.
  awk 'NR < 3 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$src"
  exit "${1:-0}"
}

compile() {
  if [ ! -f "$BIN/compile.rb" ]; then
    echo "scriptorium: compile.rb not found beside $0" >&2
    exit 1
  fi
  exec ruby "$BIN/compile.rb" "$@"
}

cmd=${1:-}
[ $# -gt 0 ] && shift

case "$cmd" in
  init)
    [ -x "$BIN/vault-init" ] || { echo "scriptorium: vault-init not found" >&2; exit 1; }
    # --create so this works on a path that isn't a vault yet; it's a no-op
    # when there already is one above the target.
    exec "$BIN/vault-init" --create "$@"
    ;;
  draft|new)
    [ -x "$BIN/draft-init" ] || { echo "scriptorium: draft-init not found" >&2; exit 1; }
    exec "$BIN/draft-init" "$@"
    ;;
  compile|build) compile "$@" ;;
  check)         compile --check "$@" ;;
  steps)         compile --steps "$@" ;;
  drafts|list)   compile --list "$@" ;;
  select)        compile --select "$@" ;;
  docx)          compile --docx "$@" ;;
  ""|help|-h|--help) usage 0 ;;
  *)
    echo "scriptorium: unknown command '$cmd'" >&2
    echo >&2
    usage 1 >&2
    ;;
esac

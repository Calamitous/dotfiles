#!/usr/bin/env ruby
# frozen_string_literal: true

# vault-init -- set up an Obsidian vault for Scriptorium.
#
#   cd ~/Writing/some-vault && vault-init
#   vault-init ~/Writing/some-vault
#   vault-init --dry-run          show what would happen, change nothing
#   vault-init --create ~/Writing/new-book    make the vault, then set it up
#
# Installs, from dotfiles/vault-template:
#
#   .gitignore                    (missing lines appended, never overwritten)
#   .vale.ini                     vale config, custom rules only
#   .vale/Prose/*.yml             the prose rules
#   .scriptorium/abbreviations.vim     per-vault abbreviations
#   .scriptorium/dictionary.utf-8.add  shared by vim's speller and harper-ls
#   .scriptorium/Scene.md              the new-chapter template (:NewScene)
#   .scriptorium/Bookmarks.md          the bookmark table
#
# Without --create it needs an existing vault: it walks up for a .obsidian
# directory and stops if there isn't one. With --create, and a path that has no
# vault above it, it makes the directory and an empty .obsidian/ first -- which
# is all Obsidian needs to adopt the folder, and all this toolchain looks for.
#
# It does NOT create a Longform draft. A new vault has nothing to compile until
# there's an Index.md with a `longform:` block in it.
#
# NON-DESTRUCTIVE. An existing file is never overwritten -- it's reported as
# kept. .gitignore is the one exception and is only ever appended to. Safe to
# re-run on a vault that's already set up, and safe to run to pick up rules
# added to the template later.

require 'fileutils'
require 'optparse'

TEMPLATE = File.expand_path('../vault-template', __dir__)

options = { dry_run: false, create: false }
OptionParser.new do |o|
  o.banner = 'Usage: vault-init [--dry-run] [--create] [vault path]'
  o.on('-n', '--dry-run', 'Show what would happen; change nothing') { options[:dry_run] = true }
  o.on('-c', '--create', 'Make the vault (and its .obsidian/) if there is none') { options[:create] = true }
  o.on('-h', '--help') { puts o; exit }
end.parse!

def vault_root(from)
  dir = File.expand_path(from)
  loop do
    return dir if Dir.exist?(File.join(dir, '.obsidian'))

    parent = File.dirname(dir)
    return nil if parent == dir

    dir = parent
  end
end

target = ARGV[0] || Dir.pwd
root = vault_root(target)

# A new vault. An empty .obsidian/ is enough: Obsidian fills it in the first
# time it opens the folder, and `.obsidian`'s mere existence is what every part
# of this toolchain looks for when it hunts upward for a vault root.
if root.nil? && options[:create]
  root = File.expand_path(target)
  writing = File.expand_path('~/Writing')

  # obsidian.nvim only registers workspaces one level under ~/Writing, so a
  # vault anywhere else works in this toolchain but won't get the Obsidian LSP.
  unless File.dirname(root) == writing
    warn "vault-init: #{root} is not directly under #{writing} --"
    warn '            obsidian.nvim will not register it as a workspace.'
  end

  if options[:dry_run]
    puts "would create #{root}/ and #{root}/.obsidian/"
  else
    FileUtils.mkdir_p(File.join(root, '.obsidian'))
    puts "created  #{root}/.obsidian/"
  end
  puts
end

unless root
  warn "vault-init: no .obsidian directory found at or above #{target}"
  warn '            pass --create to make a new vault there.'
  exit 1
end

unless Dir.exist?(TEMPLATE)
  warn "vault-init: template missing at #{TEMPLATE}"
  exit 1
end

puts "Vault: #{root}"
puts '(dry run -- nothing will be written)' if options[:dry_run]
puts

created = kept = appended = 0

Dir.glob('**/*', File::FNM_DOTMATCH, base: TEMPLATE).sort.each do |rel|
  src = File.join(TEMPLATE, rel)
  next unless File.file?(src)

  dst = File.join(root, rel)

  if rel == '.gitignore' && File.file?(dst)
    have = File.readlines(dst, chomp: true)
    want = File.readlines(src, chomp: true)
    missing = want.reject { |line| line.strip.empty? || line.start_with?('#') || have.include?(line) }

    if missing.empty?
      puts "  keep     #{rel}  (nothing to add)"
      kept += 1
    else
      puts "  append   #{rel}  (+#{missing.length} line#{'s' if missing.length != 1})"
      unless options[:dry_run]
        File.open(dst, 'a') do |f|
          f.puts('') unless have.last.to_s.strip.empty?
          f.puts('# --- writing environment ---')
          missing.each { |line| f.puts(line) }
        end
      end
      appended += 1
    end
    next
  end

  if File.exist?(dst)
    puts "  keep     #{rel}"
    kept += 1
  else
    puts "  create   #{rel}"
    unless options[:dry_run]
      FileUtils.mkdir_p(File.dirname(dst))
      FileUtils.cp(src, dst)
    end
    created += 1
  end
end

puts
puts format('%d created, %d appended, %d kept', created, appended, kept)

unless options[:dry_run] || created.zero? && appended.zero?
  puts
  puts 'Next: commit the new files so they follow the vault to your other machines.'
  puts '  .vale/ and .vale.ini      the prose rules'
  puts '  .scriptorium/             abbreviations and the shared dictionary'
  puts '  .gitignore                keeps the generated .spl out'
end

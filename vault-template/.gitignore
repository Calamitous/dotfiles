# Generated by vim's spell checker from .scriptorium/dictionary.utf-8.add.
# The .add file (your word list) IS tracked; the compiled .spl is not.
.scriptorium/*.spl

# Obsidian per-machine UI state -- churns constantly, means nothing elsewhere.
.obsidian/workspace.json
.obsidian/workspace-mobile.json

.DS_Store

# NOT ignored, deliberately: .scriptorium/session.vim is the saved window
# layout. It changes on every exit, but committing it is what lets the layout
# follow the book between machines.
